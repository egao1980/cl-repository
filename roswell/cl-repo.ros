#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#

(progn
  (ros:ensure-asdf)
  (flet ((client-tree ()
           (or (uiop:getenv-absolute-directory "CL_REPOSITORY_CLIENT_DIR")
               (let* ((script *load-pathname*)
                      (dir (and script (uiop:pathname-directory-pathname script)))
                      (parent (and dir (uiop:pathname-parent-directory-pathname dir))))
                 (when (and parent
                            (probe-file (merge-pathnames "cl-repository-client.asd" parent)))
                   parent))
               (uiop:getenv-absolute-directory "CL_REPOSITORY_DEST")
               (error "cl-repo: cannot find cl-repository-client. Install it or set CL_REPOSITORY_DEST."))))
    (let ((tree (client-tree)))
      (asdf:initialize-source-registry
       `(:source-registry (:tree ,(namestring tree)) :ignore-inherited-configuration))
      (asdf:load-system "cl-repository-client"))))

(defpackage :ros.script.cl-repo
  (:use :cl)
  (:import-from :cl-oci/runtime #:*quiet* #:*dry-run*)
  (:import-from :cl-repository-client/commands
                #:cmd-install #:cmd-list #:cmd-search #:cmd-info #:cmd-update
                #:cmd-lock #:cmd-restore #:cmd-verify
                #:*default-registry* #:*default-namespace*)
  (:import-from :cl-repository-client/project
                #:cmd-sync #:cmd-test #:cmd-run #:cmd-grovel #:client-source-tree
                #:ensure-default-registry #:discover-project-system)
  (:import-from :cl-repository-client/asd-rewrite #:cmd-add-overlay)
  (:import-from :cl-repository-client/platform-resolver
                #:choose-overlay-plists #:detect-local-platform)
  (:import-from :cl-repository-client/quickload #:add-registry)
  (:import-from :cl-repository-client/protected-systems
                #:*protected-system-prefixes*)
  (:import-from :cl-repository-client/config
                #:load-merged-config #:generate-default-config)
  (:import-from :cl-repository-client/source-policy
                #:apply-source-config))

(in-package :ros.script.cl-repo)

(defun usage ()
  (format t "~&cl-repo - OCI-based Common Lisp package manager~%~%")
  (format t "Usage: cl-repo <command> [options]~%~%")
  (format t "Commands:~%")
  (format t "  sync                  Install the .asd and qlfile dependencies~%")
  (format t "  test                  Sync, then run the system test-op~%")
  (format t "  run -- <command...>   Sync, then run a command~%")
  (format t "  grovel                Sync, load the system, write the grovel overlay~%")
  (format t "  publish               Push the source and overlays whose files exist~%")
  (format t "  publish --overlay     Push one overlay. A name selects that overlay.~%")
  (format t "  add-overlay [name]    Record an overlay in the .asd. Does not publish.~%")
  (format t "  install <ref>         Install a system (name, name:version, or full ref)~%")
  (format t "  load <names...>       Install (if needed) and load systems~%")
  (format t "  update                Update all installed systems~%")
  (format t "  list                  List installed systems~%")
  (format t "  search <query>        Search for systems~%")
  (format t "  info <ref>            Show system info~%")
  (format t "  lock                  Generate/update lockfile from installed systems~%")
  (format t "  verify [name]         Verify installed systems against file manifests~%")
  (format t "  config init           Generate default cl-repo.conf in current directory~%")
  (format t "  config show           Print effective merged configuration~%")
  (format t "~%Options:~%")
  (format t "  --locked              sync: install cl-repo.lock~%")
  (format t "  --overlay [name]      publish only this overlay~%")
  (format t "  --os [--arch] [--lisp]  add-overlay key. A bare flag means this machine.~%")
  (format t "  --registry <url>      Registry URL (default: https://ghcr.io)~%")
  (format t "  --namespace <ns>      Repository namespace (default: egao1980/cl-systems)~%")
  (format t "  --quiet               Suppress informational output~%")
  (format t "  --dry-run             Show what would be done without doing it~%")
  (format t "  --remote              For 'list': query registries instead of local~%")
  (format t "  --force               For 'load': re-resolve deps, allow upgrades~%")
  (format t "  --os <os>             Target OS for add-overlay (e.g. linux, darwin, windows)~%")
  (format t "  --arch <arch>         Target arch for add-overlay (e.g. amd64, arm64)~%")
  (format t "  --os-version <ver>    OS version for add-overlay (e.g. ubuntu-22.04, macos-14)~%")
  (format t "  --lisp <impl>         CL implementation for add-overlay (optional)~%")
  (format t "  --native-paths <p>    Comma-separated native lib paths for add-overlay~%")
  (format t "  --tag <tag>           Version tag for add-overlay (default: from .asd or latest)~%")
  (format t "  --version <ver>       Force the package version for publish~%")
  (format t "  --system <name>       ASDF system when the directory has several .asd files~%")
  (format t "  --protect <name>      Protect a system from updates (repeatable)~%")
  (format t "~%Source policy (for 'load'):~%")
  (format t "  --with <name>         Extra dependency to resolve alongside (repeatable)~%")
  (format t "  --deny <name>         Deny system from all sources (repeatable)~%")
  (format t "  --deny-from <sys:reg> Deny system from specific registry (repeatable)~%")
  (format t "  --allow-from <sys:reg> Whitelist: system only from this registry (repeatable)~%")
  (format t "  --source <sys=oci|ql> Pin system to source type (repeatable)~%")
  (format t "  --default-source <s>  Default source policy: oci, ql, or any~%")
  (format t "  --config <path>       Explicit cl-repo.conf path~%"))

(defun parse-options (args)
  "Parse --key value pairs from args. Returns (values command-args options-plist).
   Boolean flags (--quiet, --dry-run) don't consume the next argument.
   Accumulate flags (--protect) collect multiple values into a list."
  (let ((cmd-args nil)
        (options nil)
        (boolean-flags '("quiet" "dry-run" "incremental" "remote" "force" "skip-catalog"
                         "locked" "all-systems"))
        (optional-flags '("os" "arch" "lisp" "overlay"))
        (accumulate-flags '("protect" "with" "deny" "deny-from" "allow-from" "source")))
    (loop with i = 0
          while (< i (length args))
          for arg = (nth i args)
          do (cond
               ((string= arg "--")
                (loop for j from (1+ i) below (length args)
                      do (push (nth j args) cmd-args))
                (setf i (length args)))
               ((and (>= (length arg) 2) (string= "--" arg :end2 2))
                (let* ((flag-name (subseq arg 2))
                       (key (intern (string-upcase flag-name) :keyword)))
                  (cond
                    ((member flag-name boolean-flags :test #'string-equal)
                     (push t options) (push key options) (incf i))
                    ((member flag-name optional-flags :test #'string-equal)
                     (let ((next (when (< (1+ i) (length args)) (nth (1+ i) args))))
                       (if (or (null next)
                               (and (>= (length next) 2) (string= "--" next :end2 2)))
                           (progn (push :local options) (push key options) (incf i))
                           (progn (push next options) (push key options) (incf i 2)))))
                    ((member flag-name accumulate-flags :test #'string-equal)
                     (let ((val (when (< (1+ i) (length args))
                                  (nth (1+ i) args))))
                       (let ((prev (getf options key)))
                         (if prev
                             (setf (getf options key) (append prev (list val)))
                             (progn (push (list val) options) (push key options))))
                       (incf i 2)))
                    (t
                     (let ((val (when (< (1+ i) (length args))
                                  (nth (1+ i) args))))
                       (push val options)
                       (push key options)
                       (incf i 2))))))
               (t (push arg cmd-args)
                  (incf i))))
    (values (nreverse cmd-args) options)))

;;; Parse helpers for CLI flags

(defun parse-system-registry (s)
  "Parse 'system:registry' -> (values system registry).
   Special case: 'system:ql' -> (values system :ql)."
  (let ((pos (position #\: s)))
    (if pos
        (let ((name (subseq s 0 pos))
              (rest (subseq s (1+ pos))))
          (values name (if (string-equal rest "ql") :ql rest)))
        (values s nil))))

(defun parse-deny-from (s)
  "Parse deny-from CLI arg: 'system:registry' -> (:deny system :from registry)."
  (multiple-value-bind (name registry) (parse-system-registry s)
    (if registry
        (list :deny name :from registry)
        name)))

(defun parse-allow-from (s)
  "Parse allow-from CLI arg: 'system:registry' -> (:allow system :from registry)."
  (multiple-value-bind (name registry) (parse-system-registry s)
    (list :allow name :from (or registry :any))))

(defun parse-source-spec (s)
  "Parse source CLI arg: 'system=oci|ql' -> (system :oci|:ql)."
  (let ((pos (position #\= s)))
    (when pos
      (list (subseq s 0 pos)
            (intern (string-upcase (subseq s (1+ pos))) :keyword)))))

(defun flag-args (opts keys)
  "Keyword args for flags that were present. :local means this machine (NIL)."
  (loop for key in keys
        for tail = (member key opts)
        when tail
          append (list key (if (eq (second tail) :local) nil (second tail)))))

(defun overlay-opt (opts)
  "NIL when --overlay was omitted. T for a bare flag. Otherwise the name."
  (let ((tail (member :overlay opts)))
    (when tail
      (if (eq (second tail) :local) t (second tail)))))

(defun ensure-packager ()
  (unless (find-package :cl-repository-packager)
    (let ((tree (client-source-tree))
          (saved asdf:*source-registry-parameter*))
      (unwind-protect
           (progn
             (asdf:initialize-source-registry
              `(:source-registry (:tree ,(namestring tree)) :ignore-inherited-configuration))
             (asdf:load-system "cl-repository-packager"))
        (when saved
          (asdf:initialize-source-registry saved))))))

(defun psym (package name)
  (or (find-symbol name package)
      (error "cl-repo: ~a does not export ~a" package name)))

(defun publish-project (cmd-args opts registry-url namespace)
  (ensure-packager)
  (let* ((system-name (or (first cmd-args) (getf opts :system) (discover-project-system)))
         (spec (funcall (psym :cl-repository-packager/asdf-plugin "AUTO-PACKAGE-SPEC") system-name))
         (reg (or registry-url *default-registry*))
         (ns (or namespace *default-namespace*))
         (version-fn (psym :cl-repository-packager/build-matrix "PACKAGE-SPEC-VERSION"))
         (forced (or (getf opts :version) (getf opts :tag)))
         (overlay (overlay-opt opts)))
    (when forced
      (funcall (fdefinition (list 'setf version-fn)) forced spec))
    (if overlay
        (multiple-value-bind (os arch impl) (detect-local-platform)
          (let* ((plists (cl-repository-client/asd-rewrite:read-system-overlays
                          (uiop:getcwd) :system system-name))
                 (wanted (if (eq overlay t) nil overlay))
                 (matches (choose-overlay-plists plists :name wanted :os os :arch arch
                                                 :implementation impl))
                 (chosen (if wanted (first matches) (car (last matches)))))
            (unless chosen
              (error "cl-repo: no overlay~@[ ~a~] matches this machine" wanted))
            (let ((overlay-spec (funcall (psym :cl-repository-packager/build-matrix "PARSE-OVERLAY-SPEC")
                                         chosen))
                  (version (or (funcall version-fn spec) "latest")))
              (funcall (psym :cl-repository-packager/publisher "PUBLISH-OVERLAY")
                       reg ns system-name version
                       (funcall (psym :cl-repository-packager/build-matrix "BUILD-OVERLAY")
                                system-name overlay-spec :version version)))))
        (let ((result (funcall (psym :cl-repository-packager/build-matrix "BUILD-PACKAGE") spec)))
          (funcall (psym :cl-repository-packager/publisher "PUBLISH-PACKAGE")
                   reg ns (or (funcall version-fn spec) "latest") result spec)))))

(defun main (&rest argv)
  (when (or (null argv) (member "--help" argv :test #'string=) (member "-h" argv :test #'string=))
    (usage)
    (ros:quit 0))
  (multiple-value-bind (cmd-args opts) (parse-options (rest argv))
    (let* ((command (first argv))
           (registry-url (getf opts :registry))
           (namespace (getf opts :namespace))
           (*quiet* (or *quiet* (getf opts :quiet)))
           (*dry-run* (or *dry-run* (getf opts :dry-run))))
      (handler-case
          (progn
            ;; Load config early
            (let ((config (load-merged-config (getf opts :config))))
              (when config
                (apply-source-config config)))
            (ensure-default-registry)
            (when registry-url
              (add-registry registry-url
                            :namespace (or namespace *default-namespace*)
                            :priority :prepend))
            (dolist (name (getf opts :protect))
              (pushnew name *protected-system-prefixes* :test #'string=))
            (cond
            ((string-equal command "load")
             (unless cmd-args
               (format *error-output* "~&Error: load requires system name(s)~%")
               (ros:quit 1))
             (cl-repository-client/quickload:load-system
              cmd-args
              :force (getf opts :force)
              :with (getf opts :with)
              :deny (append (getf opts :deny)
                            (mapcar #'parse-deny-from (or (getf opts :deny-from) nil)))
              :allow (mapcar #'parse-allow-from (or (getf opts :allow-from) nil))
              :sources (remove nil (mapcar #'parse-source-spec (or (getf opts :source) nil)))
              :default-source (when (getf opts :default-source)
                                (intern (string-upcase (getf opts :default-source)) :keyword))
              :config-path (getf opts :config)))

            ((string-equal command "install")
             (unless cmd-args
               (format *error-output* "~&Error: install requires a reference~%")
               (ros:quit 1))
             (dolist (ref cmd-args)
               (cmd-install ref :registry-url registry-url :namespace namespace)))

            ((string-equal command "update")
             (cmd-update :registry-url registry-url :namespace namespace))

            ((string-equal command "list")
             (cmd-list :remote (getf opts :remote)))

            ((string-equal command "search")
             (unless cmd-args
               (format *error-output* "~&Error: search requires a query~%")
               (ros:quit 1))
             (cmd-search (first cmd-args) :registry-url registry-url :namespace namespace))

            ((string-equal command "info")
             (unless cmd-args
               (format *error-output* "~&Error: info requires a reference~%")
               (ros:quit 1))
             (cmd-info (first cmd-args) :registry-url registry-url :namespace namespace))

            ((string-equal command "sync")
             (cmd-sync :directory (uiop:getcwd)
                       :system (getf opts :system)
                       :overlay (overlay-opt opts)
                       :locked (getf opts :locked)))

            ((string-equal command "test")
             (cmd-test :directory (uiop:getcwd) :system (getf opts :system)
                       :overlay (overlay-opt opts)))

            ((string-equal command "run")
             (unless cmd-args
               (format *error-output* "~&Error: run requires a command after --~%")
               (ros:quit 1))
             (cmd-run cmd-args :overlay (overlay-opt opts)))

            ((string-equal command "grovel")
             (cmd-grovel :directory (uiop:getcwd) :system (getf opts :system)
                         :overlay (overlay-opt opts)))

            ((string-equal command "add-overlay")
             (apply #'cmd-add-overlay (uiop:getcwd)
                    :name (first cmd-args)
                    :system (getf opts :system)
                    (flag-args opts '(:os :arch :lisp))))

            ((string-equal command "publish")
             (publish-project cmd-args opts registry-url namespace))

            ((string-equal command "lock")
             (cmd-lock))

            ((string-equal command "restore")
             (cmd-sync :locked t))

            ((string-equal command "verify")
             (cmd-verify :system-name (first cmd-args)))

            ((string-equal command "config")
             (cond
               ((string-equal (first cmd-args) "init")
                (let ((path (generate-default-config)))
                  (format t "~&Generated ~a~%" path)))
               ((string-equal (first cmd-args) "show")
                (let ((config (load-merged-config (getf opts :config))))
                  (let ((*print-case* :downcase) (*print-pretty* t) (*print-right-margin* 100))
                    (prin1 config *standard-output*)
                    (terpri))))
               (t
                (format *error-output* "~&Usage: cl-repo config [init|show]~%")
                (ros:quit 1))))

              (t
               (format *error-output* "~&Unknown command: ~a~%~%" command)
               (usage)
               (ros:quit 1))))
        (error (e)
          (format *error-output* "~&Error: ~a~%" e)
          (ros:quit 1))))))
